PORT=3000
# 127.0.0.1 by default; in production nothing else is accepted (the app sits behind nginx)
# HOST=127.0.0.1

# The MongoDB server only, without a database name: each shop has its own database
MONGODB_URI=mongodb://127.0.0.1:27017
# The shops list, their addresses and the audit log
# CONTROL_DB=pos_control
# Each shop's database is this prefix + an id made when the shop is created
# TENANT_DB_PREFIX=pos_t_

# Shops are http://<slug>.<domain>. Development: pos.localhost; production: pos.108-61-190-4.sslip.io
# TENANT_BASE_DOMAINS=pos.localhost
# ADMIN_HOST=admin.pos.localhost
# PUBLIC_SCHEME=http
# MAX_TENANTS=20
