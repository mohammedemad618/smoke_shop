PORT=3000
# 127.0.0.1 by default; in production nothing else is accepted (the app sits behind nginx)
# HOST=127.0.0.1

# The MongoDB server only, without a database name: each shop has its own database
MONGODB_URI=mongodb://127.0.0.1:27017
# The shops list, their addresses and the audit log
# CONTROL_DB=pos_control
# Each shop's database is this prefix + an id made when the shop is created
# TENANT_DB_PREFIX=pos_t_

# Shops are http://<slug>.<domain>. Development: pos.localhost; production: pos.108-61-190-4.sslip.io
# TENANT_BASE_DOMAINS=pos.localhost
# ADMIN_HOST=admin.pos.localhost
# PUBLIC_SCHEME=http
# MAX_TENANTS=20
# New shops in any 24 hours (deleted ones count)
# MAX_NEW_TENANTS_PER_DAY=5

# The admin panel: the key that encrypts the admin's authenticator secret, 64 hex characters.
# Required to sign in to the panel (and in production to start at all). Make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then npm run admin:create. Changing it later makes the admin's authenticator unreadable.
# TOTP_KEY=

# The root worker's spool (certificates, backups, restores, drops). Unset in development:
# certificates count as issued at once and backups go to .pos-local/. Required in production.
# SPOOL_DIR=/var/lib/pos-spool
# DEV_FAKE_CERTS=1
