# /etc/systemd/system/pos-root-worker.timer: runs pos-root-worker.service every minute
# (same rhythm as niura-certs.timer), so a new shop has its certificate within about two
# minutes. Renewals are checked by the same runs, twice a day.

[Unit]
Description=POS root worker, every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
