# /etc/pos/pos.env: the POS app's settings on the server (root:pos 0640; docs/ops-runbook.md, step 5).
# Read by pos.service (node --env-file) and by the scripts run with the same --env-file.
# Compare with the .env.example of the release being deployed: a variable added there is
# needed here too. Never put a value in a command line: edit this file with nano.

NODE_ENV=production
HOST=127.0.0.1
PORT=3401

# The MongoDB server only, no database name (each shop has its own database)
MONGODB_URI=mongodb://127.0.0.1:27017
CONTROL_DB=pos_control
TENANT_DB_PREFIX=pos_t_

TENANT_BASE_DOMAINS=pos.108-61-190-4.sslip.io
ADMIN_HOST=admin.pos.108-61-190-4.sslip.io
PUBLIC_SCHEME=https

MAX_TENANTS=20
MAX_NEW_TENANTS_PER_DAY=5

# Where the app asks the root worker for certificates and backup jobs (pos-root-worker)
SPOOL_DIR=/var/lib/pos-spool

# The key that encrypts the admin's TOTP secret: 64 hex characters, made on the server with
#   printf 'TOTP_KEY=%s\n' "$(openssl rand -hex 32)" >> /etc/pos/pos.env
# (the key never appears on the screen or in the shell history). Changing it later makes the
# admin's TOTP unreadable: keep it with the backups.
# TOTP_KEY=
